# Settings for a server under load test (see server/README.md, "Load testing"). Never use them in production.
# Every simulated client comes from one address and every simulated phone shares one push host (the load tester's own
# push receiver on 127.0.0.1), so the per-address and per-push-host limits are lifted. The names contain "-", which
# shells can't export, so pass the file through env (or docker/podman --env-file):
#   env $(grep -v '^#' tools/LoadTest/server.env | xargs) dotnet run --project src/GoldfishSend.Api ...
ASPNETCORE_ENVIRONMENT=Development
Goldfish__Roles=api,worker
Goldfish__Push__DangerouslyAllowInsecureLoopback=true
Goldfish__Push__MaxInFlightPerHost=32
Goldfish__Push__MaxConnectionsPerHost=32
# TEST ONLY: tiny Argon2 parameters (8 calls of 256 KiB per proof of work) and no adaptive difficulty, so the load tester's
# own solving doesn't dominate the run. The production defaults (see PowOptions and server/README.md) cost far more.
Goldfish__Pow__BaseDifficulty=3
Goldfish__Pow__MemoryKiB=256
Goldfish__Pow__NetworkLoadThreshold=0
Goldfish__Pow__GlobalLoadThresholdPerMinute=0
Goldfish__Network__GatewayRequestsPerSecond=0
Goldfish__RateLimits__send-ip__Limit=1000000
Goldfish__RateLimits__send-ip__Burst=1000000
Goldfish__RateLimits__send-net__Limit=1000000
Goldfish__RateLimits__send-net__Burst=1000000
Goldfish__RateLimits__send-mailbox__Limit=1000000
Goldfish__RateLimits__send-mailbox__Burst=1000000
Goldfish__RateLimits__send-mailbox-day__Limit=1000000
Goldfish__RateLimits__send-mailbox-day__Burst=1000000
Goldfish__RateLimits__create-ip__Limit=1000000
Goldfish__RateLimits__create-ip__Burst=1000000
Goldfish__RateLimits__create-net__Limit=1000000
Goldfish__RateLimits__create-net__Burst=1000000
Goldfish__RateLimits__create-global__Limit=1000000
Goldfish__RateLimits__create-global__Burst=1000000
Goldfish__RateLimits__pow-ip__Limit=1000000
Goldfish__RateLimits__pow-ip__Burst=1000000
Goldfish__RateLimits__pow-net__Limit=1000000
Goldfish__RateLimits__pow-net__Burst=1000000
Goldfish__RateLimits__owner-ip__Limit=1000000
Goldfish__RateLimits__owner-ip__Burst=1000000
Goldfish__RateLimits__owner-net__Limit=1000000
Goldfish__RateLimits__owner-net__Burst=1000000
Goldfish__RateLimits__invite-create-ip__Limit=1000000
Goldfish__RateLimits__invite-create-ip__Burst=1000000
Goldfish__RateLimits__invite-create-net__Limit=1000000
Goldfish__RateLimits__invite-create-net__Burst=1000000
Goldfish__RateLimits__invite-create-global__Limit=1000000
Goldfish__RateLimits__invite-create-global__Burst=1000000
Goldfish__RateLimits__invite-fetch-ip__Limit=1000000
Goldfish__RateLimits__invite-fetch-ip__Burst=1000000
Goldfish__RateLimits__invite-fetch-net__Limit=1000000
Goldfish__RateLimits__invite-fetch-net__Burst=1000000
Goldfish__RateLimits__push-host__Limit=1000000
Goldfish__RateLimits__push-host__Burst=1000000
Goldfish__RateLimits__push-mailbox__Limit=1000000
Goldfish__RateLimits__push-mailbox__Burst=1000000
