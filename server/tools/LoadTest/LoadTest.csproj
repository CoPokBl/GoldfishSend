<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Load and smoke test for a running server, through the real encrypted gateway. It also runs a small push server, so
    the server's pushes (verification codes and messages) come back to it. See server/README.md, "Load testing".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LoadTest</AssemblyName>
    <RootNamespace>LoadTest</RootNamespace>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GoldfishSend.Core\GoldfishSend.Core.csproj" />
  </ItemGroup>
</Project>
