<?xml version="1.0" encoding="utf-8"?>
<!--
  Only in the benchmarkRelease and nonMinifiedRelease build types (see app/build.gradle.kts), never in debug or release.
  The DUMP permission limits callers to the shell (adb) and the system.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".bench.BenchSeedProvider"
            android:authorities="${applicationId}.benchseed"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
