# GoldfishSend edge proxy: TLS termination in front of the api containers.
#
# Request logging: Caddy writes NO access logs unless a site block contains a `log` directive, and
# this file deliberately has none. Do not add one. The global logger below additionally excludes the
# loggers that can carry per-request details on errors (client IP, URI, headers), so nothing about
# individual requests is ever written, only startup and certificate-management messages.
{
	# No admin API. To apply Caddyfile changes, restart the container: docker compose restart caddy
	admin off

	log default {
		output stderr
		format console
		level WARN
		# http.log.*                 access and per-request error logs (remote_ip, uri, headers)
		# http.handlers.reverse_proxy upstream errors, which include the request
		# http.stdlib                 Go net/http messages such as "TLS handshake error from <ip>:<port>"
		exclude http.log http.handlers.reverse_proxy http.stdlib
	}

	servers {
		protocols h1 h2 h3
	}

	# Optional: an ACME account e-mail for expiry notices.
	# email you@example.com
}

# Routing shared by the public HTTPS site and the optional onion service.
(goldfish_routes) {
	header -Server

	# Kestrel caps bodies at 16 KB too; this rejects oversize requests before they reach the app.
	request_body {
		max_size 16KiB
	}

	# Health endpoints are for the container healthchecks on the internal network only.
	@health path /healthz /healthz/* /readyz /readyz/*
	handle @health {
		respond 404
	}

	handle /v1/* {
		# Caddy sets X-Forwarded-For from the TCP peer and discards any client-supplied value (no
		# trusted_proxies is configured), so the api only ever sees the real client address.
		# Upstreams come from DNS, so `docker compose up --scale api=N` load-balances across every replica.
		reverse_proxy {
			dynamic a {
				name api
				port 8080
				refresh 5s
			}
			lb_policy least_conn
			lb_try_duration 5s
			fail_duration 10s
		}
	}

	# Everything else does not exist.
	handle {
		respond 404
	}
}

{$GOLDFISH_DOMAIN} {
	tls {
		# The Android client requires API 29+, which supports TLS 1.3 natively. Use
		# `protocols tls1.2 tls1.3` instead if you need to serve older clients.
		protocols tls1.3
		# Keep the same key pair across certificate renewals, so the certificate's public key (SPKI) stays
		# stable. Clients with "Pin server keys" turned on pin that key, and only a real key change warns them.
		# Rotate deliberately: remove this line once, let a renewal create a new key, announce the new
		# fingerprint (see server/README.md), then put it back.
		reuse_private_keys
	}

	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

	import goldfish_routes
}

# Optional Tor onion service (compose profile "onion"). The tor container forwards the onion's port 80 here
# over the dedicated `onion` network. Plain HTTP is correct: the onion address authenticates the server and
# Tor encrypts the connection end to end. The listener binds only to Caddy's address on that network, so
# nothing else can reach it. Every onion client arrives from the tor container's address, so the api sees
# them all as one client IP (see server/README.md, "Onion service").
http://:8081 {
	bind {$GOLDFISH_ONION_CADDY_IP:172.30.251.2}
	import goldfish_routes
}
