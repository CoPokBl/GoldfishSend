# GoldfishSend server settings for the api and worker containers.
# Copy to deploy/goldfish.env (gitignored), fill in, chmod 600. Never commit the real file.
#
# Any ASP.NET Core setting can be given here: ":" in a configuration path becomes "__",
# so Goldfish:Keys:Pepper is Goldfish__Keys__Pepper. Arrays use an index: Goldfish__Push__AllowedPorts__0=443.
# Connection strings, Goldfish__Roles, Goldfish__Network__TrustedProxies and Goldfish__Push__BlockedHosts__0
# are set in docker-compose.yml, and values there override this file.
#
# ---------------------------------------------------------------------------------------------------
# Keys (required). Generate a full set once:
#
#   docker compose build api
#   docker run --rm localhost/goldfishsend:latest keygen
#
# It prints JSON on stdout (copy each value below) and the VAPID public key on stderr.
# Back these up offline. Losing or changing them has consequences; see server/README.md:
#   Pepper, SealSalt  -> every existing mailbox is orphaned (clients must re-register all contacts)
#   EpochKek          -> every queued/held message becomes unreadable and is dropped
#   VapidPrivateKey   -> distributors that pinned the old VAPID key reject all pushes until clients re-register
# ---------------------------------------------------------------------------------------------------
Goldfish__Keys__Pepper=
Goldfish__Keys__SealSalt=
Goldfish__Keys__EpochKek=
Goldfish__Keys__VapidPrivateKey=
# Contact for push services (RFC 8292). A mailto: or https: URI you control.
Goldfish__Keys__VapidSubject=mailto:admin@push.example.com

# ---------------------------------------------------------------------------------------------------
# Optional overrides. Defaults are listed in server/README.md.
# ---------------------------------------------------------------------------------------------------
# Refuse push endpoints that resolve to this server's own public addresses.
# Goldfish__Push__ExtraBlockedRanges__0=203.0.113.10/32
# Goldfish__Push__ExtraBlockedRanges__1=2001:db8::10/128

# Goldfish__Messages__MaxTtlSeconds=1209600
# Goldfish__Pow__BaseDifficulty=20

# Rate limits: ALWAYS set all three fields of a policy. A policy given with only some fields gets 0
# for the rest, and PeriodSeconds=0 disables limiting for that policy.
# Goldfish__RateLimits__send-ip__Limit=60
# Goldfish__RateLimits__send-ip__PeriodSeconds=60
# Goldfish__RateLimits__send-ip__Burst=20

# Log level for the app's own categories (framework request logging stays at Warning).
# Logging__LogLevel__Default=Information
