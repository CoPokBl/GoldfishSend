# Compose interpolation variables. Copy to deploy/.env (gitignored) and chmod 600.
# Compose reads deploy/.env automatically; each value only reaches the services that reference it.
#
# Generate passwords with: openssl rand -hex 32
# (hex keeps them free of characters that need escaping in compose files and connection strings.)

# The public DNS name of this server. Caddy gets a certificate for it; the app refuses it as a push host.
GOLDFISH_DOMAIN=push.example.com

# MySQL: the application user. The root password is generated at random on first start (MYSQL_RANDOM_ROOT_PASSWORD)
# and printed once to the mysql container's log. Nothing in this stack needs it.
MYSQL_PASSWORD=

# Redis: the password of the "goldfish" ACL user, on the persistent queue Redis and on the
# non-persistent ephemeral Redis (rate limits). Use two different values.
REDIS_PASSWORD=
REDIS_EPHEMERAL_PASSWORD=

# Optional: the subnet of the caddy<->api network, and therefore the only source of trusted
# X-Forwarded-For headers. Change it if it collides with another network on the host.
# GOLDFISH_PUBLIC_SUBNET=172.30.250.0/24

# Optional onion service (compose profile "onion"): the caddy<->tor network and Caddy's fixed address on it.
# The address must lie inside the subnet. Change both if the subnet collides with another network.
# GOLDFISH_ONION_SUBNET=172.30.251.0/24
# GOLDFISH_ONION_CADDY_IP=172.30.251.2

# Optional: IPv6 on the public network (default true), and its ULA subnet. See docker-compose.yml.
# GOLDFISH_ENABLE_IPV6=true
# GOLDFISH_PUBLIC_SUBNET6=fd47:6f6c:6466:6973::/64

# --- Only with docker-compose.traefik.yml (running behind your existing Traefik) ---
# The external Docker network your Traefik watches, and its subnet (docker network inspect <name>). Required.
# GOLDFISH_TRAEFIK_NETWORK=traefik
# GOLDFISH_TRAEFIK_SUBNET=172.18.0.0/16
# GOLDFISH_TRAEFIK_SUBNET6=
# GOLDFISH_TRAEFIK_ENTRYPOINT=websecure
# GOLDFISH_TRAEFIK_CERTRESOLVER=letsencrypt
# Traefik behind a load balancer: trust that load balancer too, and unwrap two hops.
# GOLDFISH_UPSTREAM_PROXIES=10.0.0.0/24
# GOLDFISH_FORWARD_LIMIT=2
# Fixed address of the api on the onion network (only used with --profile onion).
# GOLDFISH_ONION_API_IP=172.30.251.3

# --- Only with docker-compose.traefik.yml (running behind your existing Traefik) ---
# The external Docker network your Traefik watches, and its subnet (docker network inspect <name>). Required.
# GOLDFISH_TRAEFIK_NETWORK=traefik
# GOLDFISH_TRAEFIK_SUBNET=172.18.0.0/16
# GOLDFISH_TRAEFIK_SUBNET6=
# GOLDFISH_TRAEFIK_ENTRYPOINT=websecure
# GOLDFISH_TRAEFIK_CERTRESOLVER=letsencrypt
# Traefik behind a load balancer: trust that load balancer too, and unwrap two hops.
# GOLDFISH_UPSTREAM_PROXIES=10.0.0.0/24
# GOLDFISH_FORWARD_LIMIT=2
# Fixed address of the api on the onion network (only used with --profile onion).
# GOLDFISH_ONION_API_IP=172.30.251.3
