# GoldfishSend MySQL 8.4 settings. Mounted read-only at /etc/mysql/conf.d/goldfish.cnf.
# Keep this file at mode 0644 (or stricter, readable by the container): mysqld ignores world-writable
# option files.
#
# The image's own /etc/my.cnf already sets skip-name-resolve, host-cache-size=0 and the datadir.

[mysqld]

# --- Durability -----------------------------------------------------------------------------------
# Every committed transaction is fsynced to the redo log. A crash loses nothing that was acknowledged.
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# --- Fewer copies of data on disk -----------------------------------------------------------------
# No binary log: this is a single node with no replica, and a binlog would be one more on-disk copy
# of every row change (mailbox rows, wrapped payloads) that outlives the rows themselves.
# If you add a replica later you need the binlog back; set binlog_expire_logs_seconds to at most the
# message max TTL so crypto-shredding still covers it.
skip-log-bin
# Undo tablespaces are truncated once they pass innodb_max_undo_log_size (default ON; stated for clarity).
innodb_undo_log_truncate = ON

# --- No query or statement logging ----------------------------------------------------------------
general_log = 0
slow_query_log = 0
# Errors and warnings only. Level 3 adds notes such as "Aborted connection ... host: ..." lines.
log_error_verbosity = 2
# performance_schema keeps recent statement texts (with their literal values) and per-digest query
# samples in memory. This server doesn't need it, and turning it off also saves ~200-400 MB of RAM.
performance_schema = OFF

# --- Time -----------------------------------------------------------------------------------------
default_time_zone = '+00:00'

# --- Network and attack surface -------------------------------------------------------------------
# MySQL is only reachable on the internal compose network. The app connects with SslMode=Required
# (MySQL 8.4 auto-generates a self-signed certificate on first start), and the server refuses any
# plaintext client (require_secure_transport). If MySQL ever
# runs on another host, also provision real certificates (ssl_ca/ssl_cert/ssl_key) and use
# SslMode=VerifyFull in the connection string.
require_secure_transport = ON
# X Protocol (port 33060) is unused.
mysqlx = OFF
local_infile = 0
# Sized for the default pool (Maximum Pool Size=50 per api or worker process) × 7 processes, plus admin headroom.
# Raise it if you scale beyond that: processes × 50 + 20.
max_connections = 400

# --- Character set --------------------------------------------------------------------------------
character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci

# --- Encryption at rest ---------------------------------------------------------------------------
# Not enabled by default, because MySQL 8.4 needs a keyring component, which needs a manifest next to the mysqld
# binary (/usr/sbin/mysqld.my) and a keyring file on a writable path. The read-only container here can't provide
# those out of the box.
#
# Why it matters: when a held message's epoch key is "shredded", the deleted key row can linger in InnoDB redo,
# undo and free pages until overwritten. With redo/undo encryption, that residue is useless without the keyring, so
# keep the keyring on a different device from the data (for example a tmpfs restored at boot, or a separate volume).
# To enable, mount a /usr/sbin/mysqld.my containing {"components": "file://component_keyring_file"} and a
# component_keyring_file.cnf pointing at the keyring path, then set:
#   innodb_redo_log_encrypt = ON
#   innodb_undo_log_encrypt = ON
#   default_table_encryption = ON
# At minimum, run the host on full-disk encryption (LUKS), and don't keep database backups longer than the message
# max TTL. Alternatively set Goldfish__EpochKeyStore=Ephemeral (see server/README.md).
